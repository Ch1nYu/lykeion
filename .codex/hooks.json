{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/check-navigation.mjs\"",
            "commandWindows": "node (Join-Path (git rev-parse --show-toplevel) '.codex/check-navigation.mjs')",
            "timeout": 15,
            "statusMessage": "Checking Lykeion Markdown and section links"
          }
        ]
      }
    ]
  }
}
